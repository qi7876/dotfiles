[init]
    defaultBranch = main
[pull]
    ff = only
[fetch]
    prune = true
[push]
    default = simple
    autoSetupRemote = true
[merge]
    conflictStyle = zdiff3
[diff]
    algorithm = histogram
    colorMoved = default
[alias]
    lg = log --graph --decorate --oneline --all
[http]
	proxy = http://127.0.0.1:7890
[https]
	proxy = http://127.0.0.1:7890
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
